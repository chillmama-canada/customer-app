# Base URL for the chillmama-Webapp backend's /api/mobile/ endpoints.
# Leave unset to use the platform-aware default in services/config.ts
# (localhost:3001 for iOS/web, 10.0.2.2:3001 for the Android emulator).
# Set explicitly when testing on a physical device — use your dev machine's LAN IP.
EXPO_PUBLIC_API_URL=http://localhost:3001
